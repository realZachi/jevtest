{
  "name": "jevtest",
  "version": "0.1.0",
  "description": "Semantic test matchers for Vitest and Jest, powered by TypeSafe's Jev model. Write expectations in plain English, get calibrated probabilities back.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realZachi/jevtest.git",
    "directory": "packages/jevtest"
  },
  "homepage": "https://github.com/realZachi/jevtest#readme",
  "bugs": {
    "url": "https://github.com/realZachi/jevtest/issues"
  },
  "sideEffects": false,
  "type": "module",
  "keywords": [
    "vitest",
    "jest",
    "matchers",
    "llm",
    "testing",
    "semantic",
    "typesafe",
    "jev"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/vitest.d.mts",
        "default": "./dist/vitest.mjs"
      },
      "require": {
        "types": "./dist/vitest.d.cts",
        "default": "./dist/vitest.cjs"
      }
    },
    "./vitest/setup": {
      "import": {
        "types": "./dist/vitest-setup.d.mts",
        "default": "./dist/vitest-setup.mjs"
      },
      "require": {
        "types": "./dist/vitest-setup.d.cts",
        "default": "./dist/vitest-setup.cjs"
      }
    },
    "./jest": {
      "import": {
        "types": "./dist/jest.d.mts",
        "default": "./dist/jest.mjs"
      },
      "require": {
        "types": "./dist/jest.d.cts",
        "default": "./dist/jest.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/integration/**'",
    "test:watch": "vitest --exclude '**/integration/**'",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "peerDependencies": {
    "vitest": ">=2.0.0",
    "jest": ">=29.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "jest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
